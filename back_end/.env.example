PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/e_vaccine_reminder
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Gmail: use a Google app password, not your account password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional SMTP server; when omitted, Nodemailer uses Gmail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# WhatsApp Cloud API: use an approved template with three body placeholders:
# child name, vaccine name, and due date, in that order.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Send reminders one day before the due date, at 09:00 server local time.
REMINDER_DAYS_BEFORE=1
REMINDER_CRON=0 9 * * *
